BasedOnStyle: LLVM
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Always
  AfterStruct: true
  AfterEnum: true
  AfterUnion: true
  BeforeElse: true
  BeforeWhile: true
AllowShortFunctionsOnASingleLine: None
ColumnLimit: 120
AlignTrailingComments: true
AlignConsecutiveMacros: AcrossEmptyLines